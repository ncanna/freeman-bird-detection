@startuml hlwdetector-component

!include _theme.puml

title hlwdetector — Component Diagram

'─────────────────────────────────────────────────────────
' Entry points
'─────────────────────────────────────────────────────────
package "Entry Points" {
    [ExperimentRunner] <<runner>> $orch
    [CLI\npython -m hlwdetector.runner] <<cli>> $orch
    [HPOptimizer] <<optimizer>> $orch
}

[CLI\npython -m hlwdetector.runner] --> [ExperimentRunner]

'─────────────────────────────────────────────────────────
' Core framework
'─────────────────────────────────────────────────────────
package "hlwdetector (Core)" {

    package "Config & Registry" $subpkg {
        [ExperimentConfig] <<dataclass>> $data
        [AdapterRegistry] <<registry>> $infra
        [paths\n(repo-root anchoring)] <<module>> $infra
    }

    package "Data Layer" $subpkg {
        [DatasetManager] <<manager>> $infra
        note right of [DatasetManager]
          Loads COCO JSON
          Partitions into
          SplitView objects
        end note
    }

    package "Artifact & Tracking" $subpkg {
        [ArtifactManager] <<manager>> $infra
        [ExperimentTracker] <<tracker>> $infra
    }

    package "Adapters" $subpkg {
        interface "BaseModelAdapter" as BMA
        [YOLOAdapter] <<adapter>> $adapter
        [RTDETRAdapter] <<adapter>> $adapter
        [SwinAdapter] <<adapter>> $adapter
        [DETRAdapter] <<adapter>> $adapter
    }

    package "Results & Scoring" $subpkg {
        [results\n(MetricsDict, TrainingResult,\nDetectionResult)] <<module>> $data
        [metrics\ncompute_coco_metrics] <<module>> $infra
        note right of [metrics\ncompute_coco_metrics]
          Shared COCOeval scoring for
          adapters whose framework does
          not report metrics itself
          (swin, detr). Builds GT in
          memory from the SplitView.
        end note
    }

    package "Visualization" $subpkg {
        [VisualizationPipeline] <<pipeline>> $viz
        [VideoAnnotator] <<annotator>> $viz
    }
}

'─────────────────────────────────────────────────────────
' External dependencies
'─────────────────────────────────────────────────────────
package "External Libraries" {
    [ultralytics] <<library>> $ext
    [transformers\n(>=5.0)] <<library>> $ext
    [timm] <<library>> $ext
    [supervision] <<library>> $ext
    [pycocotools\nCOCOeval] <<library>> $ext
    [wandb] <<library>> $ext
    [opencv-python] <<library>> $ext
    [torch / torchvision] <<library>> $ext
    [optuna] <<library>> $ext

    ' Pretrained weight sources, downloaded on first use. Kept inside this
    ' package so the edges to their client libraries stay short.
    cloud "Ultralytics\nModel Zoo" as UltraHub $ext
    cloud "HuggingFace\nHub" as HFHub $ext

    UltraHub ..> [ultralytics]           : YOLO / RT-DETR weights
    HFHub    ..> [transformers\n(>=5.0)] : DETR checkpoints
    HFHub    ..> [timm]                  : Swin backbone weights
}

'─────────────────────────────────────────────────────────
' Data stores
'─────────────────────────────────────────────────────────
package "File System" {
    database "COCO JSON\n(instances_merged.json)" as CocoJSON
    database "Split JSON\n(split.json)" as SplitJSON
    database "Images Dir\n(data/h23/images/)" as ImagesDir
    database "Outputs Dir\n(outputs/experiments/<run>/)" as OutputsDir
    database "Config YAML\n(configs/*.yaml)" as ConfigYAML
}

'─────────────────────────────────────────────────────────
' Relationships — Runner orchestration
'─────────────────────────────────────────────────────────
[ExperimentRunner] --> [ExperimentConfig]       : loads
[ExperimentRunner] --> [AdapterRegistry]        : resolves adapter
[ExperimentRunner] --> [DatasetManager]         : creates
[ExperimentRunner] --> [ArtifactManager]        : creates
[ExperimentRunner] --> [ExperimentTracker]      : creates
[ExperimentRunner] --> [VisualizationPipeline]  : calls visualize
[HPOptimizer]      --> [ExperimentConfig]       : creates per trial
[HPOptimizer]      --> [ExperimentRunner]       : creates per trial
[HPOptimizer]      --> [optuna]                 : create_study / optimize
[HPOptimizer]      --> [ArtifactManager]        : creates (study dir)

'─────────────────────────────────────────────────────────
' Adapter registry
'─────────────────────────────────────────────────────────
[AdapterRegistry] --> BMA                : registered via @register_adapter
BMA <|.. [YOLOAdapter]
BMA <|.. [RTDETRAdapter]
BMA <|.. [SwinAdapter]
BMA <|.. [DETRAdapter]

'─────────────────────────────────────────────────────────
' Adapter → library bindings
'─────────────────────────────────────────────────────────
[YOLOAdapter]          --> [ultralytics]
[RTDETRAdapter]        --> [ultralytics]
[SwinAdapter]          --> [timm]                 : Swin backbone
[SwinAdapter]          --> [torch / torchvision]  : FPN + Faster R-CNN head
[DETRAdapter]          --> [transformers\n(>=5.0)] : AutoModelForObjectDetection\nAutoImageProcessor
[DETRAdapter]          --> [torch / torchvision]  : hand-rolled training loop
[ultralytics]          --> [torch / torchvision]
[transformers\n(>=5.0)] --> [torch / torchvision]
[timm]                 --> [torch / torchvision]

'─────────────────────────────────────────────────────────
' Data flow
'─────────────────────────────────────────────────────────
[ExperimentConfig]  <.. ConfigYAML       : parsed from
[HPOptimizer]       <.. ConfigYAML       : HPO study config
[HPOptimizer]       --> OutputsDir       : writes hpo/ study dir
[DatasetManager]    <.. CocoJSON         : loads
[DatasetManager]    <.. SplitJSON        : partitions by
[DatasetManager]    <.. ImagesDir        : resolves frames from
[ArtifactManager]   --> OutputsDir       : writes artifacts

'─────────────────────────────────────────────────────────
' Portable path serialization (repo-relative store / resolve)
'─────────────────────────────────────────────────────────
[ExperimentConfig]   ..> [paths\n(repo-root anchoring)] : serialize / resolve path fields
[ArtifactManager]    ..> [paths\n(repo-root anchoring)] : store repo-rel weights & resume paths
[YOLOAdapter]        ..> [paths\n(repo-root anchoring)] : resolve best.pt at runtime
[RTDETRAdapter]      ..> [paths\n(repo-root anchoring)] : resolve best.pt at runtime
[SwinAdapter]        ..> [paths\n(repo-root anchoring)] : resolve best.pt at runtime
[DETRAdapter]        ..> [paths\n(repo-root anchoring)] : resolve best.pt at runtime

'─────────────────────────────────────────────────────────
' Evaluation & prediction
' Ultralytics adapters read metrics off results.box; the
' PyTorch-native adapters score through the metrics module.
'─────────────────────────────────────────────────────────
[YOLOAdapter]       --> [ultralytics]                  : evaluate() reads results.box
[RTDETRAdapter]     --> [ultralytics]                  : evaluate() reads results.box
[SwinAdapter]       --> [metrics\ncompute_coco_metrics] : evaluate()
[DETRAdapter]       --> [metrics\ncompute_coco_metrics] : evaluate() + per-epoch val
[metrics\ncompute_coco_metrics] --> [pycocotools\nCOCOeval] : AP@[.50:.95], AP@50
[metrics\ncompute_coco_metrics] --> [results\n(MetricsDict, TrainingResult,\nDetectionResult)] : builds MetricsDict
[metrics\ncompute_coco_metrics] <.. [DatasetManager]   : SplitView supplies GT
BMA                 ..> [results\n(MetricsDict, TrainingResult,\nDetectionResult)] : returns
BMA                 --> [supervision]           : sv.Detections (predict)

'─────────────────────────────────────────────────────────
' Tracking
'─────────────────────────────────────────────────────────
[ExperimentTracker] --> [wandb]          : W&B logging (optional)
[ExperimentTracker] --> OutputsDir      : writes metrics.json

'─────────────────────────────────────────────────────────
' Visualization
'─────────────────────────────────────────────────────────
[VisualizationPipeline] --> [VideoAnnotator]
[VideoAnnotator]        --> [opencv-python]  : reads frames / writes MP4
[VideoAnnotator]        --> OutputsDir       : saves visualizations/

@enduml
